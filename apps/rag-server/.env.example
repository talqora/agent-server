# ==========================================================================
# rag-server 环境变量模板(复制为 .env 使用;.env 已被 gitignore)
# ==========================================================================
# 本地开发"混合模式":中间件(postgres/redis/pulsar/milvus)在 docker,
# 业务跑宿主机,故连接默认指向 localhost 的偏移端口(避开 our-chat)。

# 运行环境:development / production / test
ENV=development
LOG_LEVEL=INFO
PORT=3101

# ── PostgreSQL(rag schema;端口 5433 避开 our-chat 的 5432)──
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/agent_server

# ── Redis(pub/sub 背板;端口 6380 避开 our-chat 的 6379)──
REDIS_URL=redis://localhost:6380

# ── Pulsar(任务队列)──
PULSAR_URL=pulsar://localhost:6650
PULSAR_TOPIC=rag-runs
PULSAR_SUBSCRIPTION=rag-worker

# ── Milvus(向量库;collection 带服务前缀,维度须与 embedding 模型一致)──
MILVUS_ADDRESS=localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_knowledge_chunks
MILVUS_VECTOR_SIZE=768

# ── LLM(OpenAI 兼容端点;本地默认 Ollama,生产千问等)──
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5:7b
LLM_EMBED_MODEL=nomic-embed-text

# ── 鉴权 ──
# JWKS 验签:our-chat 是 IdP,本服务用其公钥验签(留空则仅本地 HS256 兜底)
OAUTH_ISSUER=
OAUTH_JWKS_URI=
# 本地 HS256 兜底密钥(生产必须替换为足够长的随机串)
JWT_SECRET=dev-secret
JWT_EXPIRE_SECONDS=7200

# ── CORS 白名单(逗号分隔精确 origin;留空:dev 反射任意,生产拒绝跨源)──
CORS_ORIGINS=

# ── 文档摄取 ──
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_STORAGE_DIR=./storage/documents
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBED_BATCH=16

# ── 检索 / 对话 / agent ──
RAG_TOP_K=6
HISTORY_LIMIT=10
AGENT_MAX_ITERATIONS=8
